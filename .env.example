# ── Banco de Dados ──
# DATABASE_URL e POSTGRES_PASSWORD sao OBRIGATORIAS: o docker-compose recusa
# subir sem elas (nao ha mais default 'postgres:postgres'). Use uma senha forte
# e NUNCA exponha a porta 5432 publicamente.
DATABASE_URL=postgresql://postgres:SUA_SENHA_FORTE@db:5432/ballistic_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SUA_SENHA_FORTE
POSTGRES_DB=ballistic_db

# ── Criptografia PII (gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") ──
FERNET_KEY=

# ── Senha do usuario inicial 'atirador_pro' (obrigatoria no primeiro deploy em producao) ──
ADMIN_PASSWORD=

# ── AWS S3 (opcional - upload de imagens) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# ── AI Advisor (opcional - funciona offline sem estas chaves) ──
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
